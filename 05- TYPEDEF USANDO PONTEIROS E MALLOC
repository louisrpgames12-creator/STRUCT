#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char nome[25], matricula[10];
    float mediafinal;
} cadastroalunos;


void cadastro(cadastroalunos *alunos, 
               int *qtddesaprovados, 
               int *qtdaprovados, 
               cadastroalunos **desaprovados, 
               cadastroalunos **aprovados) {

    for(int i = 0; i < 10; i++) {

        printf("ME INFORME O NOME: ");
        scanf(" %25[^\n]", (alunos + i)->nome);

        printf("ME INFORME A MATRICULA: ");
        scanf(" %10[^\n]", (alunos + i)->matricula);

        printf("ME INFORME A MEDIA: ");
        scanf(" %f", &(alunos + i)->mediafinal);

        if((alunos + i)->mediafinal < 5)
            (*qtddesaprovados)++;
        else
            (*qtdaprovados)++;
    }

    *aprovados = malloc(*qtdaprovados * sizeof(cadastroalunos));
    *desaprovados = malloc(*qtddesaprovados * sizeof(cadastroalunos));
}


void testeaprovacao(cadastroalunos *alunos, 
                    int *qtddesaprovados, 
                    int *qtdaprovados, 
                    cadastroalunos *desaprovados, 
                    cadastroalunos *aprovados) {

    int somadesaprovados = 0, somaaprovados = 0;

    for(int i = 0; i < 10; i++) {

        if((alunos + i)->mediafinal < 5) {

            *(desaprovados + somadesaprovados) = *(alunos + i);
            somadesaprovados++;

        } else {

            *(aprovados + somaaprovados) = *(alunos + i);
            somaaprovados++;
        }
    }
}


void mostrar(int *qtddesaprovados, 
             int *qtdaprovados, 
             cadastroalunos *desaprovados, 
             cadastroalunos *aprovados) {

    printf("\nDESAPROVADOS:\n");

    for(int i = 0; i < *qtddesaprovados; i++) {

        printf("NOME: %s\n", (desaprovados + i)->nome);
        printf("MATRICULA: %s\n", (desaprovados + i)->matricula);
        printf("MEDIA: %.2f\n", (desaprovados + i)->mediafinal);
    }


    printf("\nAPROVADOS:\n");

    for(int i = 0; i < *qtdaprovados; i++) {

        printf("NOME: %s\n", (aprovados + i)->nome);
        printf("MATRICULA: %s\n", (aprovados + i)->matricula);
        printf("MEDIA: %.2f\n", (aprovados + i)->mediafinal);
    }
}


int main() {

    int qtddesaprovados = 0, qtdaprovados = 0;

    cadastroalunos alunos[10];

    cadastroalunos *desaprovados, *aprovados;

    cadastro(alunos, 
             &qtddesaprovados, 
             &qtdaprovados, 
             &desaprovados, 
             &aprovados);

    testeaprovacao(alunos, 
                   &qtddesaprovados, 
                   &qtdaprovados, 
                   desaprovados, 
                   aprovados);

    mostrar(&qtddesaprovados, 
            &qtdaprovados, 
            desaprovados, 
            aprovados);

    return 0;
}
