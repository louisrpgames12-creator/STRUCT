Claro. Vou manter a sua estrutura com typedef, enum, union, struct, ponteiro e ->, corrigindo apenas o que é necessário para o programa funcionar.

#include <stdio.h>

typedef union {
    int capacidade_armazenamento;
    int duracao_bateria;
    float tamanho_tela;
} infoproduto;

typedef enum {
    smartphone,
    laptop,
    smartwatch
} tipoproduto;

typedef struct {
    tipoproduto tipo;
    infoproduto info;
} produto;

void imprimirproduto(produto *questao) {

    for (int i = 0; i < 3; i++) {

        printf("\n----- PRODUTO %d -----\n", i + 1);

        switch ((questao + i)->tipo) {

            case smartphone:
                printf("Tipo: Smartphone\n");
                printf("Tamanho da tela: %.2f\n",
                       (questao + i)->info.tamanho_tela);
                break;

            case laptop:
                printf("Tipo: Laptop\n");
                printf("Capacidade de armazenamento: %d GB\n",
                       (questao + i)->info.capacidade_armazenamento);
                break;

            case smartwatch:
                printf("Tipo: Smartwatch\n");
                printf("Duracao da bateria: %d horas\n",
                       (questao + i)->info.duracao_bateria);
                break;
        }
    }
}

int main() {

    produto questao[3];

    for (int i = 0; i < 3; i++) {

        printf("\nEscolha o tipo do produto:\n");
        printf("0 - Smartphone\n");
        printf("1 - Laptop\n");
        printf("2 - Smartwatch\n");
        printf("Opcao: ");

        scanf("%d", &(questao + i)->tipo);

        switch ((questao + i)->tipo) {

            case smartphone:

                printf("Informe o tamanho da tela: ");
                scanf("%f", &(questao + i)->info.tamanho_tela);

                break;

            case laptop:

                printf("Informe a capacidade de armazenamento: ");
                scanf("%d", &(questao + i)->info.capacidade_armazenamento);

                break;

            case smartwatch:

                printf("Informe a duracao da bateria: ");
                scanf("%d", &(questao + i)->info.duracao_bateria);

                break;

            default:

                printf("Tipo de produto invalido!\n");
                i--;

                break;
        }
    }

    imprimirproduto(questao);

    return 0;
}
O ponto principal do exercício

A lógica agora é:

enum
 ↓
identifica qual produto é
 ↓
switch
 ↓
escolhe qual campo da union utilizar

Por exemplo:

questao[0].tipo = smartphone;

Então:

case smartphone:

e você armazena:

questao[0].info.tamanho_tela

Se for:

questao[1].tipo = laptop;

você usa:

questao[1].info.capacidade_armazenamento

E se for:

questao[2].tipo = smartwatch;

usa:

questao[2].info.duracao_bateria

Isso é importante porque a union só deve ter um desses campos sendo utilizado por vez.

E você continua usando exatamente a forma que estava estudando:

(questao + i)->tipo

que é equivalente a:

questao[i].tipo

Assim você pratica tanto aritmética de ponteiros quanto o operador ->.
