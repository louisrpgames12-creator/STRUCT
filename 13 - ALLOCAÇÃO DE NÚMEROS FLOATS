//Escreva uma função em C que receba como argumento um número inteiro X e um número inteiro N. A função deve gerar os elementos da série:
//X + 1/1, X + 1/2, X + 1/3, X + 1/4,   ...      , X + 1/(N-1),  X + 1/N.
//Colocar em um vetor dinâmico e, por fim, a função deve retornar o vetor gerado.
//Lembre-se que para que seja possível uma função retornar um vetor de forma segura em linguagem C esse vetor deve ser dinâmico.  
//Protótipo da função
//float * questao3(int X, int N);
//Exemplo:  na chamada vet = questao3(2, 6);  o vetor vet seria composto por:
//vet = [2+1/1, 2+1/2, 2+1/3, 2+1/4, 2+1/5, 2+1/6]//


#include <stdio.h>
#include <stdlib.h>

float *funcao(int x, int n) {
    float *vetor;
    int i;
    vetor = calloc(n, sizeof(float));

    for(i = 0; i < n; i++){
        vetor[i] = x + 1.0f/(i + 1); 
    }

    return vetor;
}

int main() {
    float x, n;
    float *vetor;
    
    printf("ME INFORME O VALOR DE X E A QUANTIDADE DE N: ");
    scanf("%f%f", &x, &n);

    vetor = funcao(x, n);
    
    for(int i = 0; i < n; i++) {
        printf("%.2f ", vetor[i]);
    }
    return 0;
}
