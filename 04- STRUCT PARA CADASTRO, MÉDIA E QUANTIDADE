#include <stdio.h>
typedef struct {
    char nome[30], cpf[12], cargo[25];
    int idade, data_nascimento, codigo, salario;
    char sexo;   
} cadastro_funcionarios;

void qtd_mulheres(cadastro_funcionarios *funcionarios, int *qtd_mulher, float *media_idade, int *qtd_salarios_5e10k) {
    int i;
    float soma_idade = 0;
     for(i = 0; i < 10; i++) {
        printf("Me informe o nome: ");
        scanf(" %30[^\n]", (funcionarios + i)->nome);
        printf("Me informe o cpf: ");
        scanf(" %12[^\n]", (funcionarios + i)->cpf);
        printf("Me informe o cargo: ");
        scanf(" %25[^\n]", (funcionarios + i)->cargo);
        printf("Me informe a idade: ");
        scanf(" %d", &(funcionarios + i)->idade);
        printf("Me informe o data: ");
        scanf(" %d", &(funcionarios + i)->data_nascimento);
        printf("Me informe o codigo: ");
        scanf(" %d", &(funcionarios + i)->codigo);
        printf("Me informe o salario: ");
        scanf(" %d", &(funcionarios + i)->salario);
        printf("Me informe o sexo[M/F]: ");
        scanf(" %c", &(funcionarios + i)->sexo);
        if((funcionarios + i)->sexo == 'f' || (funcionarios + i)->sexo == 'F')
             *qtd_mulher += 1;
        soma_idade += (funcionarios + i)->idade;
        if((funcionarios + i)->salario >= 5000 && (funcionarios + i)->salario <= 10000)
            *qtd_salarios_5e10k += 1;
    }

    *media_idade = soma_idade/10;
}

int main() {
    cadastro_funcionarios funcionarios[10];
    int qtd_mulher = 0, qtd_salarios_5e10k = 0;
    float media_idade;
    qtd_mulheres(funcionarios, &qtd_mulher, &media_idade, &qtd_salarios_5e10k);
    printf("%d", qtd_mulher);
    
    return 0;
}
