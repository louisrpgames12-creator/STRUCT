#include <stdio.h>
#include <stdlib.h>

int **funcao(int tam) {
    int **matriz, i, j;
    matriz = calloc(tam, sizeof(int *));
    for(i = 0; i < 5; i++) {
        if(i == 0) {
            matriz[i] = calloc(3, sizeof(int));
            for(j = 0; j < 3; j++) {
                matriz[i][j] = -1;
            }
        } else
            if(i == 1) {
                matriz[i] = calloc(7, sizeof(int));
                for(j = 0; j < 7; j++) {
                    matriz[i][j] = -1;
                }
            } else
                if(i == 2) {
                    matriz[i] = calloc(8, sizeof(int));
                    for(j = 0; j < 8; j++) {
                        matriz[i][j] = -1;
                    }
                } else
                    if(i == 3) {
                        matriz[i] = calloc(12, sizeof(int));
                        for(j = 0; j < 12; j++) {
                            matriz[i][j] = -1;
                        }
                    } else
                        if(i == 4) {
                            matriz[i] = calloc(9, sizeof(int));
                            for(j = 0; j < 9; j++) {
                                matriz[i][j] = -1;
                            }
                        }
                    }
    return matriz;
}

int main() {
    int **matriz, i, j;
    
   matriz = funcao(5);

    for(i = 0; i < 5; i++) {
        if(i == 0) {
            for(j = 0; j < 3; j++) {
                printf("%d ", matriz[i][j]);
            }
            printf("\n");
        } else
            if(i == 1) {
                for(j = 0; j < 7; j++) {
                    printf("%d ", matriz[i][j]);
                }
                printf("\n");
            } else
                if(i == 2) {
                    for(j = 0; j < 8; j++) {
                        printf("%d ", matriz[i][j]);
                    }
                    printf("\n");
                } else
                    if(i == 3) {
                        for(j = 0; j < 12; j++) {
                            printf("%d ", matriz[i][j]);
                        }
                        printf("\n");
                    } else
                        if(i == 4) {
                            for(j = 0; j < 9; j++) {
                                printf("%d ", matriz[i][j]);
                            }
                            printf("\n");
                        }
                    }
    
    return 0;
}
